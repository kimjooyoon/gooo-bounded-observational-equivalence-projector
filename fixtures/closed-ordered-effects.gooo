{
  "schema": "gooo.bounded-observational-equivalence/scenario/v1",
  "case_id": "closed-ordered-effects",
  "class": "normal",
  "variant": "none",
  "inputs": {"amount": {"type": "int", "int": 2}},
  "observable_state": ["counter", "mode"],
  "initial_state": {"counter": {"type": "int", "int": 1}, "mode": {"type": "string", "string": "idle"}},
  "expected_state": {"counter": {"type": "int", "int": 3}, "mode": {"type": "string", "string": "active"}},
  "declared_trace": [
    {"effect": "state.write", "subject": "counter", "value": {"type": "int", "int": 3}},
    {"effect": "event.emit", "subject": "", "value": {"type": "int", "int": 2}},
    {"effect": "state.write", "subject": "mode", "value": {"type": "string", "string": "active"}}
  ],
  "allowed_effects": ["state.write", "event.emit"],
  "bounds": {"max_steps": 8, "max_events": 4},
  "normalization": {"value_encoding": "typed-json", "state_order": "declared", "event_fields": ["ordinal", "effect", "subject", "value"], "digest": "sha256-canonical-json"},
  "operations": [
    {"op": "add_state", "field": "counter", "delta": 2},
    {"op": "emit", "effect": "event.emit", "value": {"kind": "input", "name": "amount"}},
    {"op": "set_state", "field": "mode", "value": {"kind": "literal", "value": {"type": "string", "string": "active"}}}
  ],
  "result": {"kind": "state", "name": "counter"}
}
